{
    "manifest_version": 3,
    "name": "GitLab Toggle Viewed",
    "version": "1.0",
    "description": "Adds a button to toggle all 'file viewed' checkboxes on GitLab merge request pages.",
    "content_scripts": [
        {
            "matches": [
                "https://gitlab.com/*/merge_requests/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}
